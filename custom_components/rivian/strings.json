  "issues": {
    "state_values_changed": {
      "title": "Rivian sensor states have changed",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Rivian sensor states have changed",
            "description": "This version of the Rivian integration reports sensor states as the values the vehicle sends, instead of formatted text. The dashboard still shows friendly labels, but automations, scripts and templates that compare these states need updating. For example:\n\n- Gear selector: `Park` is now `park`, and `Drive` is now `drive`\n- Drive mode: `All-Purpose` is now `everyday`, `Conserve` is `distance`, `Snow` is `winter`, `All-Terrain` is `off_road_auto`, `Soft Sand` is `off_road_sand`, `Rock Crawl` is `off_road_rocks`, `Rally` is `off_road_sport_auto` and `Drift` is `off_road_sport_drift`\n- Power state: `Vehicle Reset` is now `vehicle_reset`\n- Software OTA - Status: `Ready To Install` is now `ready_to_install`\n- Gear Guard video status: `Engaged` is now `active`\n- Remote charging available: `1` and `0` are now `true` and `false`\n\nOther states are lowercase with underscores in the same way. To see a sensor's new values, open **Developer tools > States** and look at its `options` attribute.\n\nAlso:\n\n- **Charging time elapsed** now counts only time spent actively charging.\n- **Software OTA - Install time** is now the scheduled install time, not a duration.\n- Entities for features your vehicle doesn't report have been removed.\n\nHistory recorded before this update keeps the old values."
          }
        }
      }
    },
    "analytics_db_repaired": {
      "title": "Rivian analytics database was corrupt and has been rebuilt",
      "description": "The SQLite analytics database at `.storage/rivian_analytics.db` failed an integrity check and was quarantined. A fresh database was created and the original legacy JSON drive history is still on disk as a recovery source, but recent analytics may need to be re-imported (for example via the `rivian.backfill_drive_history` service)."
    },
    "analytics_db_read_only": {
      "title": "Rivian analytics database is read-only after a downgrade",
      "description": "The analytics database schema version is newer than this version of the integration supports, which usually means the integration was downgraded. To avoid corrupting data, analytics writes are paused until you update the integration to a version that supports this schema."
    },
    "rate_limited": {
      "title": "Rivian live updates are rate limited",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Log in to Rivian again",
            "description": "Rivian has been rate limiting live vehicle updates for over {issue_after} minutes, so your vehicle's sensors aren't updating. Logging in again starts a new session, which should clear it.\n\nSelect **Submit** to log in again. If it's still rate limited after {reauth_after} hours, you'll be asked to log in again anyway."
          }
        }
      }
    }
  }
}
