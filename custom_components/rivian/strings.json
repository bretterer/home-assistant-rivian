          "analytics_retention_days": "Analytics history retention (days, 0 = keep forever)",
          "track_capture": "Store GPS routes for drives",
          "track_retention_days": "Keep GPS routes for (days, 0 = as long as the drive)",
          "track_full_detail_days": "Thin routes older than (days, 0 = never)",
          "weather_lookups": "Weather for drives"
        },
        "data_description": {
          "track_capture": "When off, drives are still recorded but no GPS route is stored for them, so the route view is unavailable.",
          "track_retention_days": "How long a drive's full GPS route is kept before it's deleted (the drive summary itself follows the analytics history retention setting above). A typical daily-driving route history runs roughly 12 MB/year at full detail.",
          "track_full_detail_days": "Routes older than this are simplified to about 10% of their original size (same overall shape, fewer points) to save storage, without being deleted.",
          "weather_lookups": "When on, each drive gets its outside temperature from the public Open-Meteo API. Only coordinates rounded to about 1 km and times are sent. When off, nothing is sent and drives show no temperature."
        }
      }
    },
